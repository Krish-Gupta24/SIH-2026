# Multi-stage Python Backend Dockerfile with EnergyPlus 24.1.0 runtime
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ENERGYPLUS_EXE=/usr/local/bin/energyplus

WORKDIR /app

# Install system runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libx11-6 \
    libgomp1 \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Download and install EnergyPlus 24.1.0 for Linux (Official NREL release)
RUN curl -SLO https://github.com/NREL/EnergyPlus/releases/download/v24.1.0/EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu22.04-x86_64.tar.gz && \
    tar -xzf EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu22.04-x86_64.tar.gz -C /usr/local/ && \
    EP_REAL_DIR=$(find /usr/local -maxdepth 1 -type d -name "*EnergyPlus*" | head -n 1) && \
    ln -sf "$EP_REAL_DIR" /usr/local/EnergyPlus-24-1-0 && \
    ln -sf "$EP_REAL_DIR" /usr/local/EnergyPlusV24-1-0 && \
    ln -sf "$EP_REAL_DIR/energyplus" /usr/local/bin/energyplus && \
    ln -sf "$EP_REAL_DIR/energyplus" /usr/bin/energyplus && \
    chmod +x /usr/local/bin/energyplus "$EP_REAL_DIR/energyplus" && \
    rm EnergyPlus-24.1.0-9d7789a3ac-Linux-Ubuntu22.04-x86_64.tar.gz

# Install python dependencies
COPY backend/requirements.txt /app/backend/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy source code & assets
COPY backend /app/backend
COPY simulation /app/simulation
COPY database /app/database

# Ensure required storage directories exist
RUN mkdir -p /app/storage/simulations /app/storage/weather /app/storage/reports

EXPOSE 8000

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
