# ==============================================================================
# SIH 2026 - Problem Statement 26051
# Area-Specific Shelter Design & Thermal Comfort Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTES:
# 1. DO NOT commit actual secrets or production passwords into git.
# 2. Copy this template to '.env' for local development:
#    cp .env.example .env
# 3. For production, generate a cryptographically strong SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enable FastAPI Swagger/ReDoc documentation and verbose server logs (false in production)
DEBUG=true

# Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# [CRITICAL SECRET] Cryptographic secret key used for HMAC-SHA256 JWT session tokens.
# Must be at least 32 characters in production. NEVER use default in production.
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# API v1 route prefix
API_V1_STR=/api/v1

# Platform identifier for metadata and logs
PROJECT_NAME="Area-Specific Shelter Thermal Simulation Platform"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + asyncpg)
# ------------------------------------------------------------------------------
# [CONFIDENTIAL SECRET] Primary async database connection URI.
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shelter_thermal_db

# Granular database connection parameters (used in migration scripts and container setups)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shelter_thermal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER & ASYNC QUEUE (Redis & Celery)
# ------------------------------------------------------------------------------
# Master switch for Redis / Celery.
# Set to 'false' in development to run simulations synchronously/locally via FastAPI without Redis.
# Set to 'true' in production when Redis and Celery worker processes are active.
ENABLE_CELERY=false

# Redis connection coordinates
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# [CONFIDENTIAL SECRET] Celery broker and result backend URLs.
# Include ':password@' if Redis authentication is enabled: redis://:yourpassword@localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional override: Set to 'true' to force Celery tasks to run synchronously in-process
# (useful for testing or local development without a running Redis server).
# If unset, automatically uses in-memory mode when Redis is offline.
CELERY_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# 4. SIMULATION ENGINES (Local Binaries - No API Keys Required)
# ------------------------------------------------------------------------------
# EnergyPlus installation path (Open source / US DOE / NREL - Free, no license key)
# Standard Windows paths: C:\EnergyPlusV24-1-0 or %USERPROFILE%\EnergyPlusV24-1-0
ENERGYPLUS_DIR=C:\EnergyPlusV24-1-0
ENERGYPLUS_EXE=C:\EnergyPlusV24-1-0\energyplus.exe

# OpenStudio CLI executable path (Optional - Free, open source from NREL)
OPENSTUDIO_EXE=C:\openstudio-3.7.0\bin\openstudio.exe

# ANSYS Installation Directory (Optional - Commercial CFD/FEA solver)
# Requires proprietary ANSYS FlexNet license server; see ANSYSLMD_LICENSE_FILE below.
ANSYS_DIR=C:\Program Files\ANSYS Inc\v241
ANSYS_FLUENT_EXE=C:\Program Files\ANSYS Inc\v241\fluent\ntbin\win64\fluent.exe

# [INTERNAL CONFIDENTIAL] ANSYS FlexNet license server pointer (e.g. 1055@license-server.local)
# Optional: Only required if executing headless ANSYS Fluent/MAPDL jobs.
# ANSYSLMD_LICENSE_FILE=1055@license-server.local
# ANSYS_LICENSE_FILE=1055@license-server.local

# ------------------------------------------------------------------------------
# 5. SIMULATION EXECUTION THROTTLING & TIMEOUTS
# ------------------------------------------------------------------------------
# Maximum timeout per individual simulation execution in seconds (default 10 min, max 30 min)
SIMULATION_TIMEOUT_SECONDS=600
MAX_SIMULATION_TIMEOUT_SECONDS=1800

# Concurrency limits and rate limiting
MAX_CONCURRENT_SIMULATIONS=4
RATE_LIMIT_SIMULATION_PER_MINUTE=15
RATE_LIMIT_GENERAL_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=15728640

# Transient simulation scratch folder (automatically cleaned after completion)
SIMULATION_TEMP_DIR=./storage/simulations

# ------------------------------------------------------------------------------
# 6. CLIMATE & WEATHER SERVICES (Public & Keyless)
# ------------------------------------------------------------------------------
# NASA POWER API Base URL (Public, Keyless REST API provided by NASA Langley Research Center)
# Documentation: https://power.larc.nasa.gov/docs/services/api/
# NOTE: NASA POWER is 100% public and open-access. NO API key is required.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
NASA_POWER_TIMEOUT_SECONDS=30

# Local cache directory for downloaded EPW meteorological files
WEATHER_CACHE_DIR=./storage/weather

# NOTE ON GOOGLE MAPS / GEOCODING / ELEVATION:
# Neither Google Maps, Google Places, nor Google Elevation are used by this platform.
# All elevation data is sourced from verified canonical location profiles or user inputs.
# NO Google API keys are required.

# ------------------------------------------------------------------------------
# 7. FILE STORAGE & ARTIFACTS
# ------------------------------------------------------------------------------
STORAGE_ROOT=./storage
REPORTS_DIR=./storage/reports

# ------------------------------------------------------------------------------
# 8. FRONTEND & CORS
# ------------------------------------------------------------------------------
# Canonical frontend origin URL
FRONTEND_URL=http://localhost:3000

# JSON array of permitted CORS origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# ------------------------------------------------------------------------------
# 9. SECURITY & SESSION TOKENS (JWT)
# ------------------------------------------------------------------------------
# Access token lifespan in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Token signature algorithm (HMAC with SHA-256)
ALGORITHM=HS256
