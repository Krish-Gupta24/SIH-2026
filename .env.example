# ==============================================================================
# SIH 2026 - Problem Statement 26051
# Area-Specific Shelter Design & Thermal Comfort Platform
# Environment Configuration Template
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
API_V1_STR=/api/v1
PROJECT_NAME="Area-Specific Shelter Thermal Simulation Platform"

# --- Database (PostgreSQL) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shelter_thermal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shelter_thermal_db

# --- Caching & Celery Message Broker (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Simulation Engines Configuration ---
# Absolute path to EnergyPlus root directory or executable
ENERGYPLUS_DIR=C:\EnergyPlusV24-1-0
ENERGYPLUS_EXE=C:\EnergyPlusV24-1-0\energyplus.exe

# OpenStudio CLI executable path (Optional / Advanced)
OPENSTUDIO_EXE=C:\openstudio-3.7.0\bin\openstudio.exe

# ANSYS Installation Directory (Optional / Cluster / External)
ANSYS_DIR=C:\Program Files\ANSYS Inc\v241
ANSYS_FLUENT_EXE=C:\Program Files\ANSYS Inc\v241\fluent\ntbin\win64\fluent.exe

# Simulation Execution Limits & Constraints
SIMULATION_TIMEOUT_SECONDS=600
SIMULATION_TEMP_DIR=./storage/simulations
MAX_CONCURRENT_SIMULATIONS=4

# --- External Weather Services ---
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
NASA_POWER_TIMEOUT_SECONDS=30
WEATHER_CACHE_DIR=./storage/weather

# --- File Storage & Artifacts ---
STORAGE_ROOT=./storage
REPORTS_DIR=./storage/reports

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Security & Auth (JWT) ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
